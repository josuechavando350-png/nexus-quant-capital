+use nqc_census_capital::replay::{
+    verify_real_source_closeout_from_directory_for_code, UpstreamAuthorityLock,
+};
+use std::{env, error::Error, fs, path::PathBuf};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args = env::args().skip(1).collect::<Vec<_>>();
+    if args.len() != 7 {
+        return Err("usage: nqc-rmc011-bounded-replay <bundle> <d08> <d09> <lock> <historical-commit> <historical-tree> <new-closeout>".into());
+    }
+    let lock = UpstreamAuthorityLock::parse_json(&fs::read(&args[3])?)?;
+    let closeout = verify_real_source_closeout_from_directory_for_code(
+        &PathBuf::from(&args[0]),
+        &args[4],
+        &args[5],
+        &lock,
+        &PathBuf::from(&args[1]),
+        &PathBuf::from(&args[2]),
+    )?;
+    let bytes = closeout.canonical_json()?;
+    use std::io::Write;
+    let mut output = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&args[6])?;
+    output.write_all(&bytes)?;
+    println!(
+        "D11_BOUNDED_RESEARCH_REPLAY_PASS sources={} requirements={} terminal={}",
+        closeout.source_count,
+        closeout.requirement_count,
+        closeout.terminal_capital_census_complete()
+    );
+    Ok(())
+}
