+// Research compatibility overlay: identical serializer and metadata, with a
+// comparison sink that checks every byte instead of retaining a second bundle.
+enum ExportedArtifact<'a> {
+    Owned(CapitalArtifactFile),
+    Compared(&'a CapitalArtifactFile),
+}
+
+impl std::ops::Deref for ExportedArtifact<'_> {
+    type Target = CapitalArtifactFile;
+    fn deref(&self) -> &Self::Target {
+        match self {
+            Self::Owned(file) => file,
+            Self::Compared(file) => file,
+        }
+    }
+}
+
+fn emit_jsonl<'a>(
+    name: &'static str,
+    records: impl IntoIterator<Item = Json>,
+    expected: Option<&'a CapitalArtifactBundle>,
+) -> Result<ExportedArtifact<'a>, CapitalError> {
+    let Some(bundle) = expected else {
+        return Ok(ExportedArtifact::Owned(CapitalArtifactFile::new(
+            name,
+            jsonl(records)?,
+        )));
+    };
+    let observed = bundle.file(name).ok_or(CapitalError::InvalidCanonical(
+        "comparison artifact missing",
+    ))?;
+    let mut offset = 0_usize;
+    let mut hasher = Sha256::new();
+    for row in records {
+        let mut encoded = canonical(&row)?;
+        encoded.push(b'\n');
+        let end = offset
+            .checked_add(encoded.len())
+            .ok_or(CapitalError::InvalidCanonical("comparison length overflow"))?;
+        if observed.bytes.get(offset..end) != Some(encoded.as_slice()) {
+            return Err(CapitalError::CanonicalDigestMismatch);
+        }
+        hasher.update(&encoded);
+        offset = end;
+    }
+    let actual: [u8; 32] = hasher.finalize().into();
+    if offset != observed.bytes.len() || actual != observed.sha256 {
+        return Err(CapitalError::CanonicalDigestMismatch);
+    }
+    Ok(ExportedArtifact::Compared(observed))
+}
+
+fn emit_bytes<'a>(
+    name: &'static str,
+    bytes: Vec<u8>,
+    expected: Option<&'a CapitalArtifactBundle>,
+) -> Result<ExportedArtifact<'a>, CapitalError> {
+    let Some(bundle) = expected else {
+        return Ok(ExportedArtifact::Owned(CapitalArtifactFile::new(
+            name, bytes,
+        )));
+    };
+    let observed = bundle.file(name).ok_or(CapitalError::InvalidCanonical(
+        "comparison artifact missing",
+    ))?;
+    if observed.bytes != bytes || observed.sha256 != sha256(&bytes) {
+        return Err(CapitalError::CanonicalDigestMismatch);
+    }
+    Ok(ExportedArtifact::Compared(observed))
+}
