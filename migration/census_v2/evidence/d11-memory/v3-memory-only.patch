+    #[test]
+    fn frozen_original_export_and_comparison_sink_have_exact_byte_parity() -> TestResult {
+        let mut l = ledger()?;
+        // A second requirement exercises the rejected output path as well.
+        l.register_requirement(CapitalRequirement::new(
+            CapitalTargetId::from_hash(hash(51)),
+            anchor(),
+            RequiredAtomicity::SameTransaction,
+            false,
+            vec![CapitalRequirementLeg::new(
+                RequirementKind::ActionPrincipal,
+                CapitalAsset::Token(address(99)),
+                Amount256::from_u128(20),
+                vec![CapitalClass::FlashSwap],
+            )?],
+            evidence(),
+        )?)?;
+        l.evaluate_all()?;
+        let a = authority_for(&l)?;
+        let p = ArtifactProvenance::for_anchor(
+            &anchor(),
+            "0123456789abcdef0123456789abcdef01234567",
+            "89abcdef0123456789abcdef0123456789abcdef",
+        )?;
+        let old = legacy_export(&l, &a, &p)?;
+        let new = export_capital_artifacts(&l, &a, &p)?;
+        assert_eq!(old, new);
+        let compared = export_capital_artifacts_to_sink(&l, &a, &p, Some(&old))?;
+        assert_eq!(compared.len(), old.files.len());
+        for c in compared {
+            match c {
+                ExportedArtifact::Compared(f) => {
+                    assert!(std::ptr::eq(f, old.file(f.name).ok_or("missing file")?))
+                }
+                ExportedArtifact::Owned(_) => {
+                    return Err("verification retained regenerated output".into())
+                }
+            }
+        }
+        verify_capital_artifact_bundle(&old)?;
+        Ok(())
+    }
+
+    #[test]
+    fn comparison_rejects_changed_tail_order_missing_newline_and_rehashed_forgeries() -> TestResult
+    {
+        let rows = vec![
+            Json::object([("n", Json::uint(1))]),
+            Json::object([("n", Json::uint(2))]),
+        ];
+        let good = jsonl(rows.clone())?;
+        let mut changed = good.clone();
+        let index = changed.len() - 3;
+        changed[index] ^= 1;
+        let mut extra = good.clone();
+        extra.push(b'\n');
+        let reverse = jsonl(rows.iter().rev().cloned())?;
+        for bytes in [
+            changed,
+            extra,
+            reverse,
+            good[..good.len() - 1].to_vec(),
+            Vec::new(),
+        ] {
+            let b = CapitalArtifactBundle {
+                files: vec![CapitalArtifactFile::from_bytes("rows", bytes)],
+            };
+            assert!(emit_jsonl("rows", rows.clone(), Some(&b)).is_err());
+        }
+        Ok(())
+    }
+
