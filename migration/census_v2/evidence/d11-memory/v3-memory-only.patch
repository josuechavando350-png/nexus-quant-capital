+/// Same validators and closeout serializer as the borrowed-input API, with
+/// disjoint lifetimes for the large bundle and upstream byte buffers.
+/// This does not change authority admission or permit a partial source set.
+pub fn verify_real_source_closeout_from_directory_for_code(
+    directory: &std::path::Path,
+    expected_code_commit: &str,
+    expected_code_tree: &str,
+    authority_lock: &UpstreamAuthorityLock,
+    d08_dir: &std::path::Path,
+    d09_dir: &std::path::Path,
+) -> Result<RealSourceCloseout, CapitalError> {
+    use crate::artifacts::{
+        CapitalArtifactFile, CAPITAL_EVIDENCE_MANIFEST_FILE, CAPITAL_FEASIBILITY_FILE,
+        CAPITAL_REJECTION_LEDGER_FILE, CAPITAL_REQUIREMENTS_FILE, CAPITAL_SOURCES_FILE,
+        CAPITAL_SUMMARY_FILE,
+    };
+    fn read(path: std::path::PathBuf) -> Result<Vec<u8>, CapitalError> {
+        std::fs::read(path).map_err(|_| CapitalError::InvalidCanonical("replay input read failed"))
+    }
+    let names = [
+        CAPITAL_SOURCES_FILE,
+        CAPITAL_REQUIREMENTS_FILE,
+        CAPITAL_FEASIBILITY_FILE,
+        CAPITAL_REJECTION_LEDGER_FILE,
+        CAPITAL_SUMMARY_FILE,
+        CAPITAL_UPSTREAM_AUTHORITY_FILE,
+        CAPITAL_EVIDENCE_MANIFEST_FILE,
+    ];
+    let files = names
+        .into_iter()
+        .map(|name| {
+            Ok(CapitalArtifactFile::from_bytes(
+                name,
+                read(directory.join(name))?,
+            ))
+        })
+        .collect::<Result<Vec<_>, CapitalError>>()?;
+    let bundle = CapitalArtifactBundle { files };
+    eprintln!("D11_BOUNDED_PHASE=verify-bundle");
+    let capital =
+        verify_capital_artifact_bundle_for_code(&bundle, expected_code_commit, expected_code_tree)?;
+    let authority_file = bundle
+        .file(CAPITAL_UPSTREAM_AUTHORITY_FILE)
+        .ok_or(CapitalError::InvalidCanonical("missing upstream authority"))?;
+    let (context, _) = parse_upstream_authority(&authority_file.bytes)?;
+    authority_lock.verify(&context)?;
+    drop(bundle);
+    eprintln!("D11_BOUNDED_PHASE=bundle-dropped-replay-upstream");
+    let state = read(d08_dir.join("market-state-manifest.jsonl"))?;
+    let tokens = read(d08_dir.join("token-admission.jsonl"))?;
+    let facts = read(d08_dir.join("pool-and-factory-facts.json"))?;
+    let manifest08 = read(d08_dir.join("evidence-manifest.json"))?;
+    let accounts = read(d09_dir.join("account-manifest.jsonl"))?;
+    let summary = read(d09_dir.join("account-summary.json"))?;
+    let manifest09 = read(d09_dir.join("evidence-manifest.json"))?;
+    let upstream = verify_upstream_consumption_by_replay(
+        &context,
+        D08ReplayInputs {
+            state_manifest_jsonl: &state,
+            token_admission_jsonl: &tokens,
+            pool_and_factory_facts_json: &facts,
+            evidence_manifest_json: &manifest08,
+        },
+        D09ReplayInputs {
+            account_manifest_jsonl: &accounts,
+            account_summary_json: &summary,
+            evidence_manifest_json: &manifest09,
+        },
+    )?;
+    real_source_closeout_from_verified(
+        CapitalReplayVerification {
+            capital,
+            upstream,
+            upstream_authority_lock_commitment: authority_lock.commitment(),
+        },
+        authority_lock,
+    )
+}
