        "patch": "@@ -0,0 +1,148 @@\n+name: NQC RMC-016 Dual Operator Winner Receipt Parity\n+\n+on:\n+  push:\n+    branches:\n+      - 'nqc/rmc016-dual-receipt-parity-20261008'\n+    paths:\n+      - 'ci/nqc-census/rmc016_two_operator_receipts.py'\n+      - 'ci/nqc-census/test_rmc016_two_operator_receipts.py'\n+      - 'ci/nqc-census/rmc016-dual-receipt-inputs.json'\n+      - 'ci/nqc-census/RMC016_DUAL_RECEIPT_PARITY_CONTRACT.md'\n+      - '.github/workflows/nqc-rmc016-dual-receipt-parity.yml'\n+  pull_request:\n+    paths:\n+      - 'ci/nqc-census/rmc016_two_operator_receipts.py'\n+      - 'ci/nqc-census/test_rmc016_two_operator_receipts.py'\n+      - 'ci/nqc-census/rmc016-dual-receipt-inputs.json'\n+      - 'ci/nqc-census/RMC016_DUAL_RECEIPT_PARITY_CONTRACT.md'\n+      - '.github/workflows/nqc-rmc016-dual-receipt-parity.yml'\n+  workflow_dispatch:\n+\n+permissions:\n+  contents: read\n+  actions: read\n+\n+concurrency:\n+  group: rmc016-dual-receipts-${{ github.ref }}\n+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n+\n+jobs:\n+  source-and-argument-preflight:\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 20\n+    steps:\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+        with:\n+          ref: ${{ github.event.pull_request.head.sha || github.sha }}\n+          fetch-depth: 0\n+      - name: Authenticate pinned source identity and offline adversarial tests\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          git merge-base --is-ancestor abe54f1f23bd7bff8c37871200f7da7c59c45ac3 HEAD\n+          test \"$(git hash-object ci/nqc-census/rmc016-production-evidence.json)\" = \\\n+            \"5d5ed3635a426d686c8a98aa3547fd5b9d8b95aa\"\n+          jq -e '\n+            .schema_version == 1 and\n+            .status == \"PINNED\" and\n+            .blocking_reasons == [] and\n+            .source.run_id == 37718661409 and\n+            .source.head_sha == \"abe54f1f23bd7bff8c37871200f7da7c59c45ac3\" and\n+            .source.tree_sha == \"c74f8d9d2c317a011284398643b2d4aa6de06e83\" and\n+            .source.workflow_name == \"NQC RMC-016 Full Liquidation Ledger Discovery\" and\n+            .source.artifact_id == 11524139188 and\n+            .source.artifact_name == \"rmc016-full-liquidation-events-abe54f1f23bd7bff8c37871200f7da7c59c45ac3\" and\n+            .source.artifact_digest == \"sha256:6b4098c1acf153106ac5b67d2c5c7db5cd0295a16c782ad8c34ae75303306204\" and\n+            .source.source_event_count == 139 and\n+            .source.source_unique_transaction_count == 127 and\n+            .realized_nexus_profitability_proven == false and\n+            .providers == [\n+              {\"provider_id\":\"drpc\",\"operator\":\"dRPC\"},\n+              {\"provider_id\":\"blast\",\"operator\":\"BlastAPI\"}\n+            ]\n+          ' ci/nqc-census/rmc016-dual-receipt-inputs.json >/dev/null\n+          python3 ci/nqc-census/test_rmc016_two_operator_receipts.py\n+          python3 -m py_compile ci/nqc-census/rmc016_two_operator_receipts.py \\\n+            ci/nqc-census/test_rmc016_two_operator_receipts.py\n+          echo RMC016_DUAL_OPERATOR_RECEIPTS_OFFLINE_GATES_PASS\n+\n+  physical-receipts:\n+    if: ${{ github.event_name == 'push' }}\n+    needs: source-and-argument-preflight\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 55\n+    env:\n+      GH_TOKEN: ${{ github.token }}\n+      INPUTS: ci/nqc-census/rmc016-dual-receipt-inputs.json\n+    steps:\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+        with:\n+          ref: ${{ github.sha }}\n+          fetch-depth: 0\n+      - name: Independently authenticate exact successful event source ZIP\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          id=\"$(jq -r '.source.run_id' \"$INPUTS\")\"\n+          sha=\"$(jq -r '.source.head_sha' \"$INPUTS\")\"\n+          tree=\"$(jq -r '.source.tree_sha' \"$INPUTS\")\"\n+          artifact=\"$(jq -r '.source.artifact_id' \"$INPUTS\")\"\n+          digest=\"$(jq -r '.source.artifact_digest' \"$INPUTS\")\"\n+          run_json=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/runs/$id\")\"\n+          artifact_json=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact\")\"\n+          test \"$(jq -r '.status' <<<\"$run_json\")\" = completed\n+          test \"$(jq -r '.conclusion' <<<\"$run_json\")\" = success\n+          test \"$(jq -r '.head_sha' <<<\"$run_json\")\" = \"$sha\"\n+          test \"$(jq -r '.name' <<<\"$run_json\")\" = \"NQC RMC-016 Full Liquidation Ledger Discovery\"\n+          test \"$(gh api \"repos/$GITHUB_REPOSITORY/git/commits/$sha\" --jq '.tree.sha')\" = \"$tree\"\n+          test \"$(jq -r '.expired' <<<\"$artifact_json\")\" = false\n+          test \"$(jq -r '.workflow_run.id' <<<\"$artifact_json\")\" = \"$id\"\n+          test \"$(jq -r '.name' <<<\"$artifact_json\")\" = \\\n+            \"rmc016-full-liquidation-events-abe54f1f23bd7bff8c37871200f7da7c59c45ac3\"\n+          test \"$(jq -r '.digest' <<<\"$artifact_json\")\" = \"$digest\"\n+          mkdir -p \"$RUNNER_TEMP/nqc016-source\"\n+          curl --fail --location --silent --show-error --retry 2 \\\n+            -H \"Authorization: Bearer $GH_TOKEN\" \\\n+            -H 'Accept: application/vnd.github+json' \\\n+            \"https://api.github.com/repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact/zip\" \\\n+            -o \"$RUNNER_TEMP/nqc016-source/source.zip\"\n+          printf '%s  %s\\n' \"$(jq -r '.source.artifact_digest|sub(\"^sha256:\";\"\")' \"$INPUTS\")\" \\\n+            \"$RUNNER_TEMP/nqc016-source/source.zip\" | sha256sum --check --strict\n+          echo \"SOURCE_ZIP=$RUNNER_TEMP/nqc016-source/source.zip\" >> \"$GITHUB_ENV\"\n+          echo \"SOURCE_SHA=$(jq -r '.source.artifact_digest|sub(\"^sha256:\";\"\")' \"$INPUTS\")\" >> \"$GITHUB_ENV\"\n+      - name: Verify 127 winner receipts from dRPC and BlastAPI and reconcile gas in wei\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          python3 ci/nqc-census/rmc016_two_operator_receipts.py \\\n+            --event-zip \"$SOURCE_ZIP\" \\\n+            --event-sha256 \"$SOURCE_SHA\" \\\n+            --providers drpc blast \\\n+            --min-interval 2 \\\n+            --out \"$RUNNER_TEMP/nqc016-dual-receipts\"\n+          jq -e '\n+            .status == \"RMC016_TWO_OPERATOR_RECEIPT_CONSISTENCY_ONLY\" and\n+            .winner_transaction_count == 127 and\n+            .event_count == 139 and\n+            .independent_source_log_completeness_certified == false and\n+            .gas_usd_conversion_completed == false and\n+            .fifteen_cost_categories_proven == false and\n+            .operator_gas_funding_proven == false and\n+            .nexus_execution_proven == false and\n+            .nexus_capture_calibrated == false and\n+            .nexus_net_pnl_proven == false and\n+            .real_market_census_closed == false and\n+            .monthly_nexus_pnl_usd == null\n+          ' \"$RUNNER_TEMP/nqc016-dual-receipts/receipt-parity-report.json\" >/dev/null\n+          (cd \"$RUNNER_TEMP/nqc016-dual-receipts\" && sha256sum -c archive.sha256)\n+          echo RMC016_HISTORICAL_WINNER_RECEIPT_PARITY_PASS_NOT_NEXUS_PNL\n+      - name: Preserve append-only authoritative-or-blocked receipt diagnostics\n+        if: always()\n+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n+        with:\n+          name: rmc016-dual-winner-receipts-${{ github.sha }}\n+          path: ${{ runner.temp }}/nqc016-dual-receipts/\n+          if-no-files-found: warn\n+          retention-days: 90\n+          compression-level: 0"
      }
    ]
  },
