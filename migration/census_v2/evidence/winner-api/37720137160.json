        "patch": "@@ -0,0 +1,152 @@\n+name: NQC RMC-016 Independent Winner Receipt Continuation\n+\n+on:\n+  push:\n+    branches:\n+      - 'nqc/rmc016-dual-receipt-parity-20261008'\n+    paths:\n+      - 'ci/nqc-census/rmc016_resume_verified_receipts.py'\n+      - 'ci/nqc-census/test_rmc016_resume_verified_receipts.py'\n+      - 'ci/nqc-census/RMC016_RESUMED_RECEIPT_PARITY_CONTRACT.md'\n+      - '.github/workflows/nqc-rmc016-resume-receipt-parity.yml'\n+  pull_request:\n+    paths:\n+      - 'ci/nqc-census/rmc016_resume_verified_receipts.py'\n+      - 'ci/nqc-census/test_rmc016_resume_verified_receipts.py'\n+      - 'ci/nqc-census/RMC016_RESUMED_RECEIPT_PARITY_CONTRACT.md'\n+      - '.github/workflows/nqc-rmc016-resume-receipt-parity.yml'\n+  workflow_dispatch:\n+\n+permissions:\n+  contents: read\n+  actions: read\n+\n+concurrency:\n+  group: nqc-rmc016-resumed-receipts-${{ github.ref }}\n+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n+\n+jobs:\n+  offline-adversarial-contract:\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 20\n+    steps:\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+        with:\n+          ref: ${{ github.event.pull_request.head.sha || github.sha }}\n+          fetch-depth: 0\n+      - name: Verify immutable historic inputs and test adversarial source recovery\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          git merge-base --is-ancestor 569d4aaeecb3d066389c054efed695be02e3ef40 HEAD\n+          test \"$(git hash-object ci/nqc-census/rmc016-production-evidence.json)\" = \\\n+            \"5d5ed3635a426d686c8a98aa3547fd5b9d8b95aa\"\n+          python3 ci/nqc-census/test_rmc016_resume_verified_receipts.py\n+          python3 -m py_compile \\\n+            ci/nqc-census/rmc016_resume_verified_receipts.py \\\n+            ci/nqc-census/test_rmc016_resume_verified_receipts.py\n+          echo RMC016_RESUMED_WINNER_RECEIPTS_ADVERSARIAL_TESTS_PASS\n+\n+  independent-blockscout-receipts:\n+    needs: offline-adversarial-contract\n+    if: ${{ github.event_name == 'push' }}\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 45\n+    env:\n+      GH_TOKEN: ${{ github.token }}\n+      SRC_RUN: '37718661409'\n+      SRC_HEAD: 'abe54f1f23bd7bff8c37871200f7da7c59c45ac3'\n+      SRC_TREE: 'c74f8d9d2c317a011284398643b2d4aa6de06e83'\n+      SRC_ARTIFACT: '11524139188'\n+      SRC_SHA: '6b4098c1acf153106ac5b67d2c5c7db5cd0295a16c782ad8c34ae75303306204'\n+      DRPC_RUN: '37719091371'\n+      DRPC_HEAD: '569d4aaeecb3d066389c054efed695be02e3ef40'\n+      DRPC_TREE: 'ba648214fb5cb1cdca1db1f42f28059054d78e63'\n+      DRPC_ARTIFACT: '11524199698'\n+      DRPC_SHA: '182b5e81b00ca04e53c9193c1496a725dc152ade9a17d3ab2dfaeb5045ac86b6'\n+    steps:\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+        with:\n+          ref: ${{ github.sha }}\n+          fetch-depth: 0\n+      - name: Authenticate canonical event source and failed dual-receipt predecessor\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          mkdir -p \"$RUNNER_TEMP/nqc016-resume-source\"\n+          check() {\n+            local run=\"$1\" head=\"$2\" tree=\"$3\" workflow=\"$4\" conclusion=\"$5\" artifact=\"$6\" name=\"$7\" digest=\"$8\" out=\"$9\"\n+            local r a\n+            r=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/runs/$run\")\"\n+            a=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact\")\"\n+            test \"$(jq -r '.status' <<<\"$r\")\" = completed\n+            test \"$(jq -r '.conclusion' <<<\"$r\")\" = \"$conclusion\"\n+            test \"$(jq -r '.name' <<<\"$r\")\" = \"$workflow\"\n+            test \"$(jq -r '.head_sha' <<<\"$r\")\" = \"$head\"\n+            test \"$(gh api \"repos/$GITHUB_REPOSITORY/git/commits/$head\" --jq '.tree.sha')\" = \"$tree\"\n+            test \"$(jq -r '.expired' <<<\"$a\")\" = false\n+            test \"$(jq -r '.workflow_run.id' <<<\"$a\")\" = \"$run\"\n+            test \"$(jq -r '.name' <<<\"$a\")\" = \"$name\"\n+            test \"$(jq -r '.digest' <<<\"$a\")\" = \"sha256:$digest\"\n+            curl --fail --silent --show-error --location --retry 2 \\\n+              -H \"Authorization: Bearer $GH_TOKEN\" \\\n+              -H 'Accept: application/vnd.github+json' \\\n+              \"https://api.github.com/repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact/zip\" -o \"$out\"\n+            printf '%s  %s\\n' \"$digest\" \"$out\" | sha256sum -c --strict\n+            echo \"RMC016_EXACT_WORKFLOW_ARTIFACT_PASS run=$run artifact=$artifact conclusion=$conclusion\"\n+          }\n+          check \"$SRC_RUN\" \"$SRC_HEAD\" \"$SRC_TREE\" \\\n+            'NQC RMC-016 Full Liquidation Ledger Discovery' success \\\n+            \"$SRC_ARTIFACT\" \"rmc016-full-liquidation-events-$SRC_HEAD\" \"$SRC_SHA\" \\\n+            \"$RUNNER_TEMP/nqc016-resume-source/events.zip\"\n+          check \"$DRPC_RUN\" \"$DRPC_HEAD\" \"$DRPC_TREE\" \\\n+            'NQC RMC-016 Dual Operator Winner Receipt Parity' failure \\\n+            \"$DRPC_ARTIFACT\" \"rmc016-dual-winner-receipts-$DRPC_HEAD\" \"$DRPC_SHA\" \\\n+            \"$RUNNER_TEMP/nqc016-resume-source/drpc-checkpoint.zip\"\n+          echo \"EVENT_ZIP=$RUNNER_TEMP/nqc016-resume-source/events.zip\" >> \"$GITHUB_ENV\"\n+          echo \"DRPC_CHECKPOINT_ZIP=$RUNNER_TEMP/nqc016-resume-source/drpc-checkpoint.zip\" >> \"$GITHUB_ENV\"\n+\n+      - name: Validate 127 Blockscout receipts against immutable 127 dRPC receipt witnesses\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          python3 ci/nqc-census/rmc016_resume_verified_receipts.py \\\n+            --source-zip \"$EVENT_ZIP\" \\\n+            --drpc-checkpoint-zip \"$DRPC_CHECKPOINT_ZIP\" \\\n+            --min-interval 3 \\\n+            --out \"$RUNNER_TEMP/nqc016-independent-receipts\"\n+          REPORT=\"$RUNNER_TEMP/nqc016-independent-receipts/receipt-parity-report.json\"\n+          jq -e '\n+            .schema_version == 1 and\n+            .status == \"RMC016_TWO_OPERATOR_RECEIPT_PARITY_HISTORICAL_ONLY\" and\n+            .historical_source_event_run_id == 37718661409 and\n+            .prior_drpc_checkpoint_run_id == 37719091371 and\n+            .prior_drpc_workflow_completed_successfully == false and\n+            .prior_drpc_receipt_stage_complete == true and\n+            .blockscout_receipt_stage_complete == true and\n+            .independent_receipt_operator_count == 2 and\n+            .source_liquidation_event_count == 139 and\n+            .unique_winner_transaction_count == 127 and\n+            .gas_paid_wei == \"448369976498898050\" and\n+            .independent_full_window_event_enumeration_certified == false and\n+            .historical_gas_usd_certified == false and\n+            .all_route_costs_certified == false and\n+            .nexus_external_gas_funding_proven == false and\n+            .nexus_execution_proven == false and\n+            .nexus_capture_calibrated == false and\n+            .nexus_realized_pnl_proven == false and\n+            .nexus_monthly_net_pnl_estimate_usd == null and\n+            .real_market_census_closed == false\n+          ' \"$REPORT\" >/dev/null\n+          (cd \"$RUNNER_TEMP/nqc016-independent-receipts\" && sha256sum -c archive.sha256)\n+          echo RMC016_127_HISTORICAL_RECEIPTS_TWO_OPERATOR_PARITY_PASS_NOT_NEXUS_PNL\n+\n+      - name: Preserve immutable success or partial second-operator receipt diagnosis\n+        if: always()\n+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n+        with:\n+          name: rmc016-resumed-independent-receipts-${{ github.sha }}\n+          path: ${{ runner.temp }}/nqc016-independent-receipts/\n+          if-no-files-found: warn\n+          retention-days: 90\n+          compression-level: 0"
      }
    ]
