_url":"https://api.github.com/users/josuechavando350-png/repos","events_url":"https://api.github.com/users/josuechavando350-png/events{/privacy}","received_events_url":"https://api.github.com/users/josuechavando350-png/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"josuechavando350-png","id":317648718,"node_id":"U_kgDOEu7vTg","avatar_url":"https://avatars.githubusercontent.com/u/317648718?v=4","gravatar_id":"","url":"https://api.github.com/users/josuechavando350-png","html_url":"https://github.com/josuechavando350-png","followers_url":"https://api.github.com/users/josuechavando350-png/followers","following_url":"https://api.github.com/users/josuechavando350-png/following{/other_user}","gists_url":"https://api.github.com/users/josuechavando350-png/gists{/gist_id}","starred_url":"https://api.github.com/users/josuechavando350-png/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/josuechavando350-png/subscriptions","organizations_url":"https://api.github.com/users/josuechavando350-png/orgs","repos_url":"https://api.github.com/users/josuechavando350-png/repos","events_url":"https://api.github.com/users/josuechavando350-png/events{/privacy}","received_events_url":"https://api.github.com/users/josuechavando350-png/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1c00465703cc4fc87e94cbbc8c67404c78c9e8b6","url":"https://api.github.com/repos/josuechavando350-png/nexus-engine/commits/1c00465703cc4fc87e94cbbc8c67404c78c9e8b6","html_url":"https://github.com/josuechavando350-png/nexus-engine/commit/1c00465703cc4fc87e94cbbc8c67404c78c9e8b6"}],"stats":{"total":43,"additions":43,"deletions":0},"files":[{"sha":"b5866f9dd1048232f42524812ad579cfa7d3a67f","filename":".github/workflows/nqc-rmc007-stale-run-cleanup.yml","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/josuechavando350-png/nexus-engine/blob/bcd5fd0dd454c367a0fb1b1b3f19a9a85eb1dee2/.github%2Fworkflows%2Fnqc-rmc007-stale-run-cleanup.yml","raw_url":"https://github.com/josuechavando350-png/nexus-engine/raw/bcd5fd0dd454c367a0fb1b1b3f19a9a85eb1dee2/.github%2Fworkflows%2Fnqc-rmc007-stale-run-cleanup.yml","contents_url":"https://api.github.com/repos/josuechavando350-png/nexus-engine/contents/.github%2Fworkflows%2Fnqc-rmc007-stale-run-cleanup.yml?ref=bcd5fd0dd454c367a0fb1b1b3f19a9a85eb1dee2","patch":"@@ -0,0 +1,43 @@\n+name: NQC RMC-007 Stale Run Cleanup\n+\n+on:\n+  push:\n+    branches:\n+      - \"nqc/rmc-011-derived-authority-lock-20260930\"\n+    paths:\n+      - \".github/workflows/nqc-rmc007-stale-run-cleanup.yml\"\n+\n+permissions:\n+  contents: read\n+  actions: write\n+\n+jobs:\n+  cancel-stale-failed-rmc007:\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 10\n+    steps:\n+      - name: Cancel stale failed D07 live acquisitions only\n+        shell: bash\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+          REPOSITORY: ${{ github.repository }}\n+          CURRENT_HEAD: ${{ github.sha }}\n+          BRANCH: ${{ github.ref_name }}\n+        run: |\n+          set -euo pipefail\n+          cancelled=0\n+          while read -r run head status; do\n+            [ -n \"$run\" ] || continue\n+            [ \"$head\" != \"$CURRENT_HEAD\" ] || continue\n+            if [ \"$status\" = queued ] || [ \"$status\" = in_progress ]; then\n+              failed=$(gh api \"repos/$REPOSITORY/actions/runs/$run/jobs?per_page=100\" \\\n+                --jq '[.jobs[] | select(.conclusion == \"failure\")] | length')\n+              if [ \"$failed\" != 0 ]; then\n+                gh api --method POST \"repos/$REPOSITORY/actions/runs/$run/cancel\"\n+                echo \"RMC007_STALE_FAILED_CANCELLED run=$run head=$head failed_jobs=$failed\"\n+                cancelled=$((cancelled + 1))\n+              fi\n+            fi\n+          done < <(gh api \"repos/$REPOSITORY/actions/workflows/nqc-census-v2-discovery.yml/runs?event=workflow_dispatch&branch=$BRANCH&per_page=50\" \\\n+            --jq '.workflow_runs[] | [.id, .head_sha, .status] | @tsv')\n+          echo \"RMC007_STALE_FAILED_CANCEL_COUNT=$cancelled\""}]}
